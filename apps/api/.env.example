PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-development-secret
DATA_PROVIDER=json
DEMO_DATA_FILE=data/demo-data.json
DEMO_UPLOAD_DIR=uploads
# Leave STATIC_DIR unset in development. Vite serves the site and proxies /api.
# Production on Render serves apps/web/dist from this API process.
